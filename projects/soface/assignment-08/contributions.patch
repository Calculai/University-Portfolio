diff --git a/src/chat_client.cpp b/src/chat_client.cpp
index 6ce2486..142e668 100644
--- a/src/chat_client.cpp
+++ b/src/chat_client.cpp
@@ -13,8 +13,13 @@ zmq::context_t ctx;
 std::map<std::string,zmq::socket_t> name_to_socket;
 std::mutex name_to_socket_lock;
 
-void send_func(std::string whereis_endpoint)
+void send_func(std::string whereis_endpoint, std::string sender_name)
 {   
+// since the messages never even touch the server, we can't have the receiver
+// ask the server for the sender so we have to send the sender as part
+// of the message therefore we need to pass the sender name
+// but since we already need the name of the sender when we registre in the
+// server then it is available to us in the client 
 
     zmq::socket_t sock(ctx,zmq::socket_type::req);
     zmq::message_t request;
@@ -26,7 +31,7 @@ void send_func(std::string whereis_endpoint)
 
         auto split = msg.find(",");
         std::string recipient = msg.substr(0, split);
-        std::string text = msg.substr(split + 1);
+        std::string text = msg.substr(split + 2); // fixed spacing
         bool recipient_located = true;
 
         // check if we already have an connection to the recipient
@@ -64,6 +69,8 @@ void send_func(std::string whereis_endpoint)
         {
             maybe_socket = name_to_socket.find(recipient);
             std::cout << "sending message: '" << text << "' to: '" << recipient << "'" << std::endl; 
+            text = sender_name + ":" + text;
+            // we just add our sender onto the text they send and then parse it on the receiving side
             maybe_socket->second.send(zmq::buffer(text));
         }
     }
@@ -80,7 +87,20 @@ void recv_func(std::string endpoint)
     while(true)
     {
         auto _ = sock.recv(msg);
-        std::cout << "recieved message: '" << msg.to_string() << "'" << std::endl;
+        std::string full = msg.to_string();
+
+        // since we now pass the name we need to parse the message in the same way the send function does
+        auto split = full.find(":");
+        std::string sender = full.substr(0, split);
+        std::string text = full.substr(split + 1);
+
+        // not really needed though since we could format the string like:
+        // text ="'" + sender_name + "': " + text;
+        // and then just print it after we receive it but the version I 
+        // did is more interresting
+
+        // and then add on the sender in the print
+        std::cout << "received message from '" << sender << "': '" << text << "'" << std::endl;
     }
 }
 
@@ -112,7 +132,7 @@ int main(int argc, char **argv)
     std::cout << "client successfully registered" << std::endl;
     std::cout << "to send a message type a message of the form: 'recipient,message' and then press enter" << std::endl;
 
-    std::thread send_thread(send_func,server_whereis_client_endpoint);
+    std::thread send_thread(send_func,server_whereis_client_endpoint,name);
     std::thread recv_thread(recv_func,recv_endpoint);
 
     send_thread.join();
